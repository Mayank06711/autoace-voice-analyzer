# --- auth (required in prod) ---
APP_ADMIN_KEY=changeme
APP_SESSION_SECRET=dev-secret-change-me

# --- emotion (vendor-neutral; mock needs no key) ---
APP_EMOTION_MODE=api            # api | local | disabled
APP_EMOTION_PROVIDER=gemini     # mock | openai | gemini   (primary, used only if no CHAIN set)
APP_EMOTION_FALLBACK=openai     # secondary provider tried if the primary fails (used if no CHAIN)
# Preferred: a best→cheapest→cross-provider cascade (each 429/quota degrades to the next model).
# 3.6-flash HEARS the noise but is ~$0.0045/min (over ceiling); the lite tiers are cost-safe.
APP_EMOTION_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,gemini:gemini-2.5-flash-lite,openai:gpt-audio-mini
APP_GEMINI_MODEL=gemini-2.5-flash-lite   # default gemini model when a chain step omits one
APP_OPENAI_MODEL=gpt-audio-mini          # default openai model
APP_EMOTION_MODEL=              # generic override; each provider takes it only if the family matches
APP_COMPARE_MODEL=gpt-4o-mini   # cheap text model that judges predictions vs labels (not gemini)
APP_EMOTION_TWO_PASS=false      # true = isolate+describe customer then classify (2 API calls)
APP_VAD_BACKEND=webrtc          # webrtc (validated default) | silero (needs models/silero_vad.onnx)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- detectors ---
APP_OVERLAP_METHOD=auto         # auto | llm | heuristic | pyannote
APP_NOISE_TYPE_ENABLED=true

# --- server / concurrency ---
APP_PORT=8000
APP_MAX_WORKERS=3
APP_API_CONCURRENCY=10
APP_FILE_TIMEOUT_S=120

# --- storage (pluggable) ---
APP_STORAGE_BACKEND=local       # local | s3 | r2 | gcs | azure | supabase
APP_STORAGE_DIR=storage
APP_STORAGE_BUCKET=
APP_STORAGE_PREFIX=batches

# --- db / logs ---
APP_DB_URL=sqlite:///storage/app.db
APP_LOG_LEVEL=INFO
APP_LOG_DIR=logs
APP_LOG_JSON=true
